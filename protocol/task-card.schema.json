{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "protocol/task-card.schema.json",
  "title": "task-card",
  "type": "object",
  "required": [
    "type",
    "id",
    "project",
    "from",
    "to",
    "task",
    "inputs",
    "acceptance"
  ],
  "properties": {
    "type": {
      "const": "task-card"
    },
    "id": {
      "type": "string",
      "pattern": "^tc-\\d{3}$"
    },
    "project": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+$"
    },
    "from": {
      "enum": [
        "00-chief-of-staff",
        "01-news",
        "02-ideation",
        "03-research",
        "04-copywriter",
        "05-visual",
        "06-layout",
        "07-reviewer",
        "user"
      ]
    },
    "to": {
      "enum": [
        "00-chief-of-staff",
        "01-news",
        "02-ideation",
        "03-research",
        "04-copywriter",
        "05-visual",
        "06-layout",
        "07-reviewer",
        "user"
      ]
    },
    "task": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "output_dir": {
      "type": "string"
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "due": {
      "type": "string"
    }
  }
}
